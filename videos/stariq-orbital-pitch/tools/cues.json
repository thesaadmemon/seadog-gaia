{
 "vo01": [
  {
   "text": "Every ninety minutes,",
   "start": 1.6,
   "end": 2.78
  },
  {
   "text": "a satellite circles our planet,",
   "start": 2.78,
   "end": 4.75
  },
  {
   "text": "capturing more data than it can ever send home.",
   "start": 4.75,
   "end": 7.34
  }
 ],
 "vo02": [
  {
   "text": "So what if it could think for itself?",
   "start": 7.79,
   "end": 9.43
  }
 ],
 "vo03": [
  {
   "text": "Star eye-cue.",
   "start": 10.33,
   "end": 11.38
  },
  {
   "text": "Intelligence,",
   "start": 11.38,
   "end": 12.33
  },
  {
   "text": "in orbit.",
   "start": 12.33,
   "end": 13.02
  }
 ],
 "vo04": [
  {
   "text": "With AI on board,",
   "start": 13.92,
   "end": 15.13
  },
  {
   "text": "a satellite sends answers,",
   "start": 15.13,
   "end": 16.92
  },
  {
   "text": "not raw data,",
   "start": 16.92,
   "end": 18.0
  },
  {
   "text": "and reacts without waiting for Earth.",
   "start": 18.0,
   "end": 19.87
  }
 ],
 "vo05a": [
  {
   "text": "But space is hostile to computers.",
   "start": 20.57,
   "end": 22.58
  }
 ],
 "vo05b": [
  {
   "text": "One radiation particle can change data inside an AI chip.",
   "start": 22.88,
   "end": 26.84
  }
 ],
 "vo05c": [
  {
   "text": "Linux can crash.",
   "start": 27.14,
   "end": 28.25
  }
 ],
 "vo05d": [
  {
   "text": "Or worse,",
   "start": 28.6,
   "end": 29.1
  },
  {
   "text": "the system keeps running,",
   "start": 29.1,
   "end": 30.49
  },
  {
   "text": "while its answer is silently wrong.",
   "start": 30.49,
   "end": 32.38
  }
 ],
 "vo06": [
  {
   "text": "Our research,",
   "start": 33.18,
   "end": 34.01
  },
  {
   "text": "published in I triple E and on NASA's website,",
   "start": 34.01,
   "end": 37.06
  },
  {
   "text": "is the first comparison of radiation-sensitive Linux components across three commercial chip platforms.",
   "start": 37.06,
   "end": 43.25
  }
 ],
 "vo07": [
  {
   "text": "The newest platform ran two to three times longer.",
   "start": 43.65,
   "end": 46.49
  },
  {
   "text": "That evidence shows us which software to protect.",
   "start": 46.49,
   "end": 49.22
  }
 ],
 "vo08": [
  {
   "text": "Star eye-cue combines hardened Linux,",
   "start": 50.02,
   "end": 52.4
  },
  {
   "text": "AI protection,",
   "start": 52.4,
   "end": 53.67
  },
  {
   "text": "and automatic recovery,",
   "start": 53.67,
   "end": 55.09
  },
  {
   "text": "in one platform.",
   "start": 55.09,
   "end": 56.29
  }
 ],
 "vo09": [
  {
   "text": "It keeps the operating system alive,",
   "start": 56.64,
   "end": 58.76
  },
  {
   "text": "catches corrupted AI results,",
   "start": 58.76,
   "end": 61.13
  },
  {
   "text": "restores the workload,",
   "start": 61.13,
   "end": 62.47
  },
  {
   "text": "and recovers on its own,",
   "start": 62.47,
   "end": 63.98
  },
  {
   "text": "with no operator on Earth.",
   "start": 63.98,
   "end": 65.58
  }
 ],
 "vo10a": [
  {
   "text": "And the shift to orbital AI has already begun.",
   "start": 66.38,
   "end": 69.05
  }
 ],
 "vo10b": [
  {
   "text": "Google launched a prototype AI satellite.",
   "start": 69.34,
   "end": 71.84
  }
 ],
 "vo10c": [
  {
   "text": "Starcloud flew Nvidia's H one hundred in orbit.",
   "start": 72.14,
   "end": 75.13
  }
 ],
 "vo10d": [
  {
   "text": "SpaceX has proposed up to a million orbital data-center satellites.",
   "start": 75.43,
   "end": 79.46
  }
 ],
 "vo11": [
  {
   "text": "All in a space economy heading past one trillion dollars.",
   "start": 79.86,
   "end": 83.17
  }
 ],
 "vo12": [
  {
   "text": "We'll sell protected AI compute modules and software licences,",
   "start": 83.97,
   "end": 87.77
  },
  {
   "text": "and fly Satellite Zero,",
   "start": 87.77,
   "end": 89.55
  },
  {
   "text": "our own pilot mission,",
   "start": 89.55,
   "end": 91.07
  },
  {
   "text": "starting with Earth observation,",
   "start": 91.07,
   "end": 93.01
  },
  {
   "text": "disaster monitoring,",
   "start": 93.01,
   "end": 94.31
  },
  {
   "text": "and communications.",
   "start": 94.31,
   "end": 95.46
  }
 ],
 "vo13": [
  {
   "text": "Star eye-cue is led by Doctor Saad Memon,",
   "start": 96.27,
   "end": 99.08
  },
  {
   "text": "a PhD in radiation-resilient computing,",
   "start": 99.08,
   "end": 102.25
  },
  {
   "text": "with co-founders from NASA and the European Space Agency.",
   "start": 102.25,
   "end": 105.86
  }
 ],
 "vo14": [
  {
   "text": "We're raising one point five million euros,",
   "start": 106.67,
   "end": 109.48
  },
  {
   "text": "to go from prototype,",
   "start": 109.48,
   "end": 110.99
  },
  {
   "text": "to radiation validation and customer pilots,",
   "start": 110.99,
   "end": 113.98
  },
  {
   "text": "to an orbital demonstration,",
   "start": 113.98,
   "end": 115.88
  },
  {
   "text": "in twenty-four months.",
   "start": 115.88,
   "end": 117.14
  }
 ],
 "vo15": [
  {
   "text": "Star eye-cue.",
   "start": 118.14,
   "end": 119.2
  },
  {
   "text": "Powerful AI,",
   "start": 119.2,
   "end": 120.12
  },
  {
   "text": "built for space.",
   "start": 120.12,
   "end": 121.38
  }
 ]
}